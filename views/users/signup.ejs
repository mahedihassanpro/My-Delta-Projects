<% layout("/layouts/boilerplate") %>
<div class="row">
  <div class="col-6 offset-3">
    <h1 class="text-center text-uppercase">SignUp For WanderLust</h1>
    <form method="POST" action="/signup" novalidate class="needs-validation">
        <div class="mb-3">
          <label for="username">Username:</label>
          <input
            type="text"
            name="username"
            id="username"
            class="form-control"
            required
          />
          <div class="valid-feedback">Looks good!</div>
        </div>
        
        <div class="mb-3">
            <label for="email">Email:</label>
            <input
              type="email"
              name="email"
              id="email"
              class="form-control"
              required
            />
          </div>
        
          <div class="mb-3">
              <label for="password">Password:</label>
              <input
                type="password"
                name="password"
                id="password"
                class="form-control"
                required
              />
            </div>
          <button class="btn">SignUp</button>
      </div>


      
    </form>
  </div>
</div>
<br /><br />
