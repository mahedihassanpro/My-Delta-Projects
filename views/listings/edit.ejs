<% layout("/layouts/boilerplate") %> <br />
<br />
<h3 class="text-center text-uppercase">Edit your listing</h3>

<div class="row">
  <div class="col-md-8 offset-2">
    <form
      method="POST"
      novalidate
      class="needs-validation"
      action="/listings/<%= listing._id  %>?_method=PUT"
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <label for="title">Title:</label>
        <input
          type="text"
          name="listing[title]"
          value="<%= listing.title  %>"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Please add a proper title.</div>
      </div>

      <div class="mb-3">
        <label for="description">Description:</label>
        <textarea
          type="text"
          required
          name="listing[description]"
          class="form-control"
        >
          <%= listing.description  %></textarea
        >
      </div>

      <div class="mb-3">
        Orginal Listing Image: <br />
        <img src="<%= originalImageUrl  %>" alt="" />
      </div>
      <div class="mb-3">
        <label for="image">Upload New Image:</label>
        <input
          type="file"
          class="form-control"
          name="listing[image]"
          value="<%= listing.image  %>"
        />
      </div>

      <div class="row">
        <div class="col-md-4">
          <div class="mb-3">
            <label for="price">Price:</label>
            <input
              required
              type="number"
              class="form-control"
              name="listing[price]"
              value="<%= listing.price  %>"
            />
            <div class="invalid-feedback">Please enter a valid price</div>
          </div>
        </div>
        <div class="col-md-8">
          <label for="country">Country: </label>
          <input
            type="text"
            name="listing[country]"
            class="form-control"
            required
            value="<%= listing.country  %>"
          />
          <div class="invalid-feedback">Please enter the country name</div>
        </div>
      </div>
      <div class="mb-3">
        <label for="location">Location:</label>
        <input
          type="text"
          required
          name="listing[location]"
          class="form-control"
          value="<%= listing.location  %>"
        />
        <div class="invalid-feedback">Add exact location</div>
      </div>

      <button class="btn btn-dark">Edit</button>
    </form>
    <form method="POST" action="/listings/<%= listing._id  %>/?_method=DELETE">
      <button class="btn show-btn mt-3">Delete This Listing</button>
    </form>
  </div>
</div>
<br /><br />
