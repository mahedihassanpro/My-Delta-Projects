<% layout("/layouts/boilerplate") %> <br /><br />
<h3 class="text-center text-uppercase">Create a new listing</h3>
<div class="row">
  <div class="col-8 offset-2">
    <form
      method="POST"
      action="/listings"
      novalidate
      class="needs-validation"
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <label for="title">Title:</label>
        <input
          type="text"
          name="listing[title]"
          placeholder="Add a catchy house title"
          class="form-control"
          required
        />
        <div class="valid-feedback">Title Looks good!</div>
      </div>

      <div class="mb-3">
        <label for="description">Description:</label>
        <textarea
          type="text"
          class="form-control"
          name="listing[description]"
          placeholder="description"
          required
        >
        </textarea>
      </div>

      <div class="mb-3">
        <label for="image">Upload Listing Image:</label>
        <input
          type="file"
          name="listing[image]"
          class="form-control"
          required
        />
      </div>
      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price ">Price:</label>
          <input
            name="listing[price]"
            placeholder="120000"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Please enter a valid price</div>
        </div>

        <div class="mb-3 col-md-8">
          <label for="country">Country:</label>
          <input
            type="text"
            name="listing[country]"
            placeholder="Bangladesh"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Please enter a valid country name</div>
        </div>
      </div>

      <div class="mb-3">
        <label for="location">Location:</label>
        <input
          type="text"
          name="listing[location]"
          placeholder="Coxs Bazar, Chittagong"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Please enter a valid Location</div>
      </div>

      <button class="btn">Add</button>
    </form>
  </div>
</div>
<br /><br />
